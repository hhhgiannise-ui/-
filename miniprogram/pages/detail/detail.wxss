.page {
  padding-top: 20rpx;
}

.subject {
  display: inline-block;
  font-size: 22rpx;
  color: #1aad19;
  background: #e8f7e8;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.stem {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.7;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.tag-row {
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  background: #f0f7ff;
  color: #2b7de9;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.row {
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.row-label {
  color: #666;
}

.step {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
}

.step-content {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.empty-card {
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
